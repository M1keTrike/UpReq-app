          "sql": "CREATE TABLE IF NOT EXISTS \"stakeholders\" (\"id\" TEXT NOT NULL, \"project_id\" TEXT NOT NULL REFERENCES projects (id), \"name\" TEXT NOT NULL, \"role\" TEXT NULL, \"area\" TEXT NULL, \"influence\" TEXT NOT NULL, \"notes\" TEXT NULL, \"status\" TEXT NOT NULL DEFAULT 'active', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
